# Scale AMM - Git Ignore Rules
# Prevents committing secrets, keys, build artifacts, and sensitive files

# Anchor build outputs
.anchor
target/
**/*.rs.bk
node_modules
test-ledger

# IDL binaries
*.so

# CRITICAL: Never commit keypairs or wallet files!
*.json
!package.json
!tsconfig.json
!Anchor.toml

# Environment
.env
.env.local

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build
dist/
build/

# Solana
test-ledger/
.config/
