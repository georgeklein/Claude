# Scale AMM - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# Network Configuration
# ============================================================================

# Solana RPC endpoint (required)
# Options:
# - Mainnet: https://api.mainnet-beta.solana.com
# - Devnet: https://api.devnet.solana.com
# - Testnet: https://api.testnet.solana.com
# - Custom RPC (recommended for production): https://your-rpc-provider.com
SOLANA_RPC_URL=https://api.devnet.solana.com

# Anchor wallet path (required for deployment)
# Default: ~/.config/solana/id.json
ANCHOR_WALLET=~/.config/solana/id.json

# ============================================================================
# Program IDs
# ============================================================================

# Scale AMM Program ID (deployed program address)
# Get this after running: anchor deploy
# Example: CReamVLMa2dFi8RmKJQAYWn8Jy2yN5qvSu8gKFCxfp3
PROGRAM_ID=

# CRX Token Mint Address (required)
# Your CRX token mint public key
CRX_MINT=

# ============================================================================
# Protocol Configuration
# ============================================================================

# CRX Price Oracle (Pyth or Switchboard)
# Leave empty if using manual price updates
CRX_ORACLE=

# Protocol fee recipient wallet (required)
# Address that receives protocol fees
FEE_RECIPIENT=

# Initial CRX price in USD (6 decimals)
# Example: 2000000 = $2.00
INITIAL_CRX_PRICE_USD=2000000

# ============================================================================
# Wallet Configuration
# ============================================================================

# Deployer wallet private key (base58 encoded)
# NEVER commit this to git!
# Get from: cat ~/.config/solana/id.json | base58
WALLET_PRIVATE_KEY=

# Authority wallet (for admin operations)
# Usually same as deployer wallet
AUTHORITY_WALLET=

# ============================================================================
# Fee Sponsorship (Optional)
# ============================================================================

# Sponsor wallet private key for gasless transactions
# Only needed if implementing fee sponsorship
SPONSOR_WALLET=

# ============================================================================
# Testing Configuration
# ============================================================================

# Test mode (set to true for local testing)
TEST_MODE=false

# Number of test iterations for load tests
TEST_ITERATIONS=1000

# ============================================================================
# Monitoring & Analytics (Optional)
# ============================================================================

# Sentry DSN for error tracking
SENTRY_DSN=

# Datadog API key for metrics
DATADOG_API_KEY=

# Custom analytics endpoint
ANALYTICS_ENDPOINT=

# ============================================================================
# Development Settings
# ============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable verbose logging
VERBOSE=false

# ============================================================================
# Advanced Settings
# ============================================================================

# Commitment level: processed, confirmed, finalized
COMMITMENT=confirmed

# Transaction confirmation timeout (milliseconds)
TX_TIMEOUT=60000

# Max retries for failed transactions
MAX_RETRIES=3

# RPC request timeout (milliseconds)
RPC_TIMEOUT=30000
