# Scale AMM - Environment Variables
#
# Template for configuring RPC endpoints, CRX token, oracle feeds, and security keys
# Copy to .env and fill in real values - NEVER commit .env to git!

# Solana Network
SOLANA_NETWORK=mainnet-beta
RPC_URL=https://api.mainnet-beta.solana.com

# Program Deployment
DEPLOYER_KEYPAIR_PATH=~/.config/solana/deployer.json
PROGRAM_KEYPAIR_PATH=./target/deploy/creator_amm_v2-keypair.json

# CRX Token
CRX_MINT=YOUR_CRX_MINT_ADDRESS
CRX_DECIMALS=9

# Oracle
CRX_PYTH_PRICE_FEED=YOUR_PYTH_FEED_ADDRESS
ORACLE_MAX_AGE_SECONDS=60
ORACLE_MAX_CONFIDENCE_BPS=100

# Platform Config
FEE_RECIPIENT_ADDRESS=YOUR_MULTISIG_ADDRESS
PLATFORM_AUTHORITY=YOUR_AUTHORITY_ADDRESS

# AMM Parameters
PRE_BONDING_FEE_BPS=300
PRE_BONDING_THRESHOLD_USD=40000000000
POST_BONDING_FEE_BPS=100
GRADUATION_THRESHOLD_USD=85000000000

# Anti-Sniper
ANTI_SNIPER_WINDOW_SLOTS=20
ANTI_SNIPER_MAX_TRADE_BPS=500

# Security
ENCRYPTION_KEY=GENERATE_STRONG_KEY_HERE
API_SECRET=GENERATE_SECRET_HERE
