# Scale AMM - Deployment Configuration
#
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ============================================
# REQUIRED: Deployer Wallet
# ============================================
# Path to your Solana wallet keypair
# The wallet MUST already exist and be funded before deployment
#
# To generate a wallet: solana-keygen new
# To get devnet SOL: solana airdrop 2 --url devnet
# To get testnet SOL: solana airdrop 2 --url testnet
# For mainnet: Purchase 5+ SOL and send to your wallet
DEPLOYER_KEYPAIR=~/.config/solana/id.json

# ============================================
# REQUIRED: Protocol Configuration
# ============================================
# Fee recipient wallet (receives protocol fees)
FEE_RECIPIENT_ADDRESS=YourFeeRecipientPublicKeyHere

# CRX token mint address
CRX_MINT_ADDRESS=YourCRXMintAddressHere

# Pyth oracle price feed for CRX/USD
CRX_PRICE_ORACLE_ADDRESS=YourPythOracleFeedAddressHere

# ============================================
# OPTIONAL: Approved Quote Tokens
# ============================================
# Comma-separated list of approved quote token mints
# CRX is automatically included as the first approved token
# Leave empty to only use CRX
APPROVED_QUOTE_TOKENS=

# ============================================
# OPTIONAL: RPC Endpoints
# ============================================
# Custom RPC endpoints (leave blank to use defaults)
DEVNET_RPC_URL=https://api.devnet.solana.com
TESTNET_RPC_URL=https://api.testnet.solana.com
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# ============================================
# Deployment Requirements Checklist
# ============================================
# Before deploying, ensure:
# [ ] Wallet exists and has private key at DEPLOYER_KEYPAIR path
# [ ] Wallet is funded (2+ SOL for devnet, 5+ SOL for mainnet)
# [ ] FEE_RECIPIENT_ADDRESS is set to a valid address
# [ ] CRX_MINT_ADDRESS is set to your CRX token mint
# [ ] CRX_PRICE_ORACLE_ADDRESS is set to Pyth feed address
# [ ] Updated DEPLOYER_PUBKEY in programs/creator-amm-v2/src/instructions/initialize.rs
